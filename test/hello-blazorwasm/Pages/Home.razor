@page "/"
@inject IJSRuntime JS

<h1>Hello from Blazor WebAssembly</h1>

<p>
    This app runs in ArkWeb on OpenHarmony. The host HAP embeds the publish output under
    <code>resources/rawfile</code> and serves it through <code>Web.onInterceptRequest</code>
    (see <code>arkts-host/</code>), so no local HTTP server is involved.
</p>

<p>Runtime: <code>@RuntimeInformation.FrameworkDescription</code></p>
<p>OS: <code>@RuntimeInformation.OSDescription</code></p>

<p><a href="counter">Open the interactive counter</a></p>

@code {
    private bool markerSent = false;

    // Fires after the first render of the app's root page: proof that the WASM runtime
    // booted, executed .NET code and rendered the component. The host forwards BLZ_*
    // console output to hilog (see ../../arkts-host/README.md).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !markerSent)
        {
            markerSent = true;
            await JS.InvokeVoidAsync("console.log", "BLZ_RENDERED");
        }
    }
}
