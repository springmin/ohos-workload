<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Minimal Blazor WebAssembly app for the OpenHarmony SDK smoke (see README.md).
       The publish recipe (official rc.2 flight + SDK pack version overrides) is pinned in
       Directory.Build.targets; override BlazorFlightVersion to move to another flight. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
    <BlazorFlightVersion Condition="'$(BlazorFlightVersion)' == ''">11.0.0-rc.2.26504.105</BlazorFlightVersion>
    <!-- The workload's forked SDK band and the official rc.2 Blazor/WebAssembly flight
         differ, so the framework reference follows the pack flight. A command-line
         -p:RuntimeFrameworkVersion=... still wins. -->
    <RuntimeFrameworkVersion Condition="'$(RuntimeFrameworkVersion)' == ''">$(BlazorFlightVersion)</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(BlazorFlightVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="$(BlazorFlightVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
