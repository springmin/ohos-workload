<?xml version="1.0" encoding="utf-8"?>
<!-- The workload's runtime line (rc.1) does not publish the Blazor/WebAssembly flights to
     nuget.org; they live on the dnceng public dotnet11 feed. Local source lists are cleared so
     a machine-level source cannot shadow the pinned flights (nuget.org itself is kept for the
     ordinary transitive packages). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="dnceng-dotnet11" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json" />
  </packageSources>
</configuration>
