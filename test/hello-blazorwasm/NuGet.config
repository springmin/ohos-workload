<?xml version="1.0" encoding="utf-8"?>
<!-- The recipe pins an official rc.2 Blazor/WebAssembly flight (BlazorFlightVersion), which is
     published on nuget.org, so nuget.org is the only source. Local source lists are cleared so
     a machine-level source cannot shadow the pinned flight. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
