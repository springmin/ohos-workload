<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>hosting-context-json-smoke</AssemblyName>
    <RootNamespace>Microsoft.OpenHarmony.Hosting.Smoke</RootNamespace>
    <!-- FIX-INTEROP #3: the same switch the shipping app payload must enable. With it, the
         test fails immediately if the Hosting assembly regresses to reflection-based
         System.Text.Json instead of its source-generated HostJsonContext. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- The hosting assembly under test is built from this repository; a ProjectReference
         keeps `dotnet run` self-contained (no pre-built DLL required). -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Microsoft.OpenHarmony.Hosting/Microsoft.OpenHarmony.Hosting.csproj" />
  </ItemGroup>
</Project>
