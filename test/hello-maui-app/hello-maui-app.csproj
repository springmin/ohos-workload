<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-openharmony26.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1418</NoWarn>
    <!-- The MAUI platform slice lives in the maui-ohos fork; point this at its sources. -->
    <OpenHarmonyMauiPlatformDir Condition=" '$(OpenHarmonyMauiPlatformDir)' == '' ">$(MSBuildThisFileDirectory)../../../maui-ohos/src/Core/src/Platform/OpenHarmony</OpenHarmonyMauiPlatformDir>
    <OpenHarmonyHostingDir Condition=" '$(OpenHarmonyHostingDir)' == '' ">$(MSBuildThisFileDirectory)../../src</OpenHarmonyHostingDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0-rc.1.26451.6" />
    <PackageReference Include="Microsoft.Maui.Graphics" Version="11.0.0-rc.1.26451.6" />
    <Reference Include="Microsoft.OpenHarmony.Hosting">
      <HintPath>$(OpenHarmonyHostingDir)/Microsoft.OpenHarmony.Hosting/bin/Release/net11.0/Microsoft.OpenHarmony.Hosting.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.OpenHarmony.Maui.Graphics">
      <HintPath>$(OpenHarmonyHostingDir)/Microsoft.OpenHarmony.Maui.Graphics/bin/Release/net11.0/Microsoft.OpenHarmony.Maui.Graphics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Compile Include="$(OpenHarmonyMauiPlatformDir)/*.cs" />
  </ItemGroup>
</Project>
