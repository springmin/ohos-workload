<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!-- The OpenHarmony slice compiles source-generated LibraryImport marshalling, which the
         generator emits as unsafe code; the slice sources are compiled into this project. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFrameworks>net11.0-openharmony20.0;net11.0-openharmony26.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The Razor SDK (not plain Microsoft.NET.Sdk) is what runs the static-web-assets publish
         pipeline for the BlazorWebView package; a MAUI SDK app gets the same pipeline through
         UseMaui, this repo builds without the MAUI workload. -->
    <!-- S1: this project compiles the platform slice sources directly (the Compile Include
         below), and the slice's BlazorWebView handler/registration is behind this constant;
         without both the package reference and the define a BlazorWebView control has no
         OpenHarmony handler and renders nothing. -->
    <DefineConstants>$(DefineConstants);OPENHARMONY_BLAZOR_WEBVIEW</DefineConstants>
    <!-- BlazorWebView IPC under NativeAOT: Microsoft.AspNetCore.Components.WebView's
         JsonSerializerOptionsProvider only adds its reflection type-info resolver when
         JsonSerializer.IsReflectionEnabledByDefault is true, and the .NET SDK turns that switch
         off as soon as the publish is trimmed (PublishAot). Keep the resolver on (the
         device-verified samples do the same). -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- The MAUI platform slice lives in the maui-ohos fork; point this at its sources. The
         ../../../ default assumes the standard sibling checkout layout
         (<parent>/ohos-workload + <parent>/maui-ohos); pass
         -p:OpenHarmonyMauiPlatformDir=<path> from a git worktree elsewhere (the publish
         scripts below carry the flag). -->
    <OpenHarmonyMauiPlatformDir Condition=" '$(OpenHarmonyMauiPlatformDir)' == '' ">$(MSBuildThisFileDirectory)../../../maui-ohos/src/Core/src/Platform/OpenHarmony</OpenHarmonyMauiPlatformDir>
    <OpenHarmonyHostingDir Condition=" '$(OpenHarmonyHostingDir)' == '' ">$(MSBuildThisFileDirectory)../../src</OpenHarmonyHostingDir>
    <!-- HarmonyOS bundle names accept only letters, digits, '_' and '.' (a hyphen is rejected
         at install with bm 9568344). The sample deliberately keeps the demo's bundle name:
         the pack's prebuilt UI-shell abc is built for com.example.hellomauiapp and the device
         resolves <bundle>/<module>/ets/entryability/EntryAbility against the abc records, so a
         different bundle would need ARKTS_SHELL_BUNDLE_NAME + a full ArkTS shell rebuild. The
         install therefore replaces the demo on the device; restore the kit hap afterwards. -->
    <OpenHarmonyBundleName Condition=" '$(OpenHarmonyBundleName)' == '' ">com.example.hellomauiapp</OpenHarmonyBundleName>
    <!-- NativeAOT variant (AOT-MAUI): the marker is inferred from PublishAot so the documented
         `dotnet publish -p:PublishAot=true` needs no extra property; the variant compiles the
         app to a native shared library (NativeLib=Shared) with its own openharmony_app_main
         export (AotEntry.cs under OPENHARMONY_AOT). -->
    <OpenHarmonyAotApp Condition=" '$(OpenHarmonyAotApp)' == '' and '$(PublishAot)' == 'true' ">true</OpenHarmonyAotApp>
    <PublishAot Condition=" '$(OpenHarmonyAotApp)' == 'true' ">true</PublishAot>
    <NativeLib Condition=" '$(OpenHarmonyAotApp)' == 'true' and '$(NativeLib)' == '' ">Shared</NativeLib>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(OpenHarmonyAotApp)' == 'true' ">
    <DefineConstants>$(DefineConstants);OPENHARMONY_AOT</DefineConstants>
    <!-- NativeAOT's shared-library mode is only reachable from a library project; the AOT app
         has no managed entry point to generate (the host dlopens libhello-maui-hybrid.so and
         calls the openharmony_app_main export from AotEntry.cs). -->
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Razor SDK publishes every *.json in the project (static-web-assets content rules);
         the hap staging generates the real module.json/resources into its own stage directory,
         so keep the hand-built fixtures out of the publish set. -->
    <Content Remove="module.json" />
    <Content Remove="resources/**" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0-rc.2.26478.12" />
    <PackageReference Include="Microsoft.Maui.Graphics" Version="11.0.0-rc.2.26478.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="11.0.0-rc.2.26478.12" />
    <Reference Include="Microsoft.OpenHarmony.Hosting">
      <HintPath>$(OpenHarmonyHostingDir)/Microsoft.OpenHarmony.Hosting/bin/Release/net11.0/Microsoft.OpenHarmony.Hosting.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.OpenHarmony.Maui.Graphics">
      <HintPath>$(OpenHarmonyHostingDir)/Microsoft.OpenHarmony.Maui.Graphics/bin/Release/net11.0/Microsoft.OpenHarmony.Maui.Graphics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Compile Include="$(OpenHarmonyMauiPlatformDir)/*.cs" />
  </ItemGroup>
</Project>
