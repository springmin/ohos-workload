<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- The R2b drift assertion walks up from the slice directory to find the native host source
         (src/OpenHarmonyHost/openharmony_host.c) when the harness itself is not inside the
         ohos-workload checkout (scratch copies). -->
    <AssemblyMetadata Include="MauiSliceDir" Value="$(MauiSliceDir)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0-rc.1.26451.6" />
    <PackageReference Include="Microsoft.Maui.Graphics" Version="11.0.0-rc.1.26451.6" />
    <!-- The slice's BlazorWebView handler compiles against these types (test/Directory.Build.props
         defines OPENHARMONY_BLAZOR_WEBVIEW, matching the slice's own compile vehicle). -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="11.0.0-rc.1.26451.6" />
    <!-- First-party assemblies default to ProjectReferences; a pinned HOSTING_DLL /
         OPENHARMONY_GRAPHICS_DLL (or -p:HostingDll=) still wins. Roots come from
         test/Directory.Build.props. -->
    <ProjectReference Include="$(HostingProject)" Condition="'$(HostingDll)' == ''" />
    <ProjectReference Include="$(GraphicsProject)" Condition="'$(OpenHarmonyGraphicsDll)' == ''" />
    <Reference Include="Microsoft.OpenHarmony.Hosting" Condition="'$(HostingDll)' != ''">
      <HintPath>$(HostingDll)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.OpenHarmony.Maui.Graphics" Condition="'$(OpenHarmonyGraphicsDll)' != ''">
      <HintPath>$(OpenHarmonyGraphicsDll)</HintPath>
      <Private>true</Private>
    </Reference>
    <Compile Include="$(MauiSliceDir)/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <MauiXaml Include="XamlPage.xaml" />
  </ItemGroup>

  <Target Name="_VerifyMauiPlatformVerifyInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(MauiSliceDir)' == ''"
           Text="MauiSliceDir is empty. Check out springmin/maui-ohos and set MAUI_SLICE_DIR (or pass -p:MauiSliceDir=&lt;dir&gt;)." />
    <Error Condition="'$(MauiSliceDir)' != '' and !Exists('$(MauiSliceDir)')"
           Text="The maui-ohos slice directory '$(MauiSliceDir)' does not exist. Check out springmin/maui-ohos next to ohos-workload, or set MAUI_SLICE_DIR (or -p:MauiSliceDir=&lt;dir&gt;) to src/Core/src/Platform/OpenHarmony." />
    <Error Condition="'$(HostingDll)' != '' and !Exists('$(HostingDll)')"
           Text="HostingDll '$(HostingDll)' does not exist; drop the override to use the ProjectReference to $(HostingProject)." />
    <Error Condition="'$(OpenHarmonyGraphicsDll)' != '' and !Exists('$(OpenHarmonyGraphicsDll)')"
           Text="OpenHarmonyGraphicsDll '$(OpenHarmonyGraphicsDll)' does not exist; drop the override to use the ProjectReference to $(GraphicsProject)." />
  </Target>
</Project>
