<Project>
  <!-- Single-source import guard: the SDK resolver imports this file once, but an explicit
       <Import> (or a future manifest change) must not duplicate the platform symbols, items or
       the Hap.targets import. The marker is captured before it is set, so the first import
       applies and any later one is a no-op (audit V3/V10 regression). -->
  <PropertyGroup Condition=" '$(TargetPlatformIdentifier)' == 'openharmony' ">
    <_OpenHarmonySdkTargetsAlreadyImported Condition=" '$(MicrosoftOpenHarmonySdkTargetsImported)' == 'true' ">true</_OpenHarmonySdkTargetsAlreadyImported>
    <MicrosoftOpenHarmonySdkTargetsImported>true</MicrosoftOpenHarmonySdkTargetsImported>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetPlatformIdentifier)' == 'openharmony' and '$(_OpenHarmonySdkTargetsAlreadyImported)' != 'true' ">
    <TargetPlatformSupported>true</TargetPlatformSupported>
    <TargetPlatformDisplayName>OpenHarmony</TargetPlatformDisplayName>
    <!-- Platform symbols, matching the convention of the other platform SDKs (ANDROID, ...). -->
    <DefineConstants Condition=" '$(DisableImplicitFrameworkDefines)' != 'true' ">$(DefineConstants);OPENHARMONY;__OPENHARMONY__</DefineConstants>
    <SupportedOSPlatformVersion Condition=" '$(SupportedOSPlatformVersion)' == '' ">20.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition=" '$(SupportedOSPlatformVersion)' != '' and !$(SupportedOSPlatformVersion.Contains('.')) ">$(SupportedOSPlatformVersion).0</SupportedOSPlatformVersion>
    <!-- Host model: the .hap host, not a classic apphost. -->
    <UseAppHost Condition=" '$(UseAppHost)' == '' ">false</UseAppHost>
    <SelfContained Condition=" '$(SelfContained)' == '' ">true</SelfContained>
    <AllowSelfContainedWithoutRuntimeIdentifier Condition=" '$(AllowSelfContainedWithoutRuntimeIdentifier)' == '' ">true</AllowSelfContainedWithoutRuntimeIdentifier>
    <GenerateDependencyFile Condition=" '$(GenerateDependencyFile)' == '' ">false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies Condition=" '$(CopyLocalLockFileAssemblies)' == '' ">true</CopyLocalLockFileAssemblies>
    <!-- No classic apphost: the .hap host (NAPI) loads hostfxr. The SDK's built-in
         apphost-less RID list does not know openharmony yet. -->
    <_RuntimeIdentifierUsesAppHost Condition=" '$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('openharmony')) ">false</_RuntimeIdentifierUsesAppHost>
    <!-- The openharmony RIDs are not in the SDK's bundled RID graph yet; the workload carries
         one. The legacy branch honors UseRidGraph=true (the SDK's own legacy graph has no
         openharmony entries); the portable branch (the default for net8+) is the graph that is
         byte-synced with sdk-ohos/eng/PortableRuntimeIdentifierGraph.openharmony.json by
         scripts/sync-ridgraph.sh. -->
    <RuntimeIdentifierGraphPath Condition=" '$(RuntimeIdentifierGraphPath)' == '' and '$(UseRidGraph)' == 'true' ">$(MSBuildThisFileDirectory)../ridgraph/RuntimeIdentifierGraph.openharmony.json</RuntimeIdentifierGraphPath>
    <RuntimeIdentifierGraphPath Condition=" '$(RuntimeIdentifierGraphPath)' == '' ">$(MSBuildThisFileDirectory)../ridgraph/PortableRuntimeIdentifierGraph.openharmony.json</RuntimeIdentifierGraphPath>
  </PropertyGroup>


  <Import Project="$(MSBuildThisFileDirectory)../targets/OpenHarmony.Hap.targets"
          Condition=" '$(TargetPlatformIdentifier)' == 'openharmony' and '$(_OpenHarmonySdkTargetsAlreadyImported)' != 'true' " />

  <!-- Platform items (single source; guarded by the import marker so a second import through a
       different path cannot duplicate them). -->
  <Import Project="$(MSBuildThisFileDirectory)../targets/OpenHarmony.PlatformItems.targets"
          Condition=" '$(TargetPlatformIdentifier)' == 'openharmony' and '$(_OpenHarmonySdkTargetsAlreadyImported)' != 'true' " />
</Project>
