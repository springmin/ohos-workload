<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Microsoft.OpenHarmony.Hosting</AssemblyName>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- FIX-INTEROP #3: make the source-generated JSON the only path. With reflection
         serialization disabled, any regression back to JsonSerializer.Deserialize<T>/<T> is
         refused at runtime (and the trimming analyzer keeps flagging the compile-time IL2026/
         IL3050), instead of silently working under the JIT and failing under AOT. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- FIX-INTEROP #10: keep the trim/AOT analyzers on for this assembly on every build. The
         platform slice sets the same switches; a regression is a build failure in CI. -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <!-- FIX-INTEROP P2: [assembly: DisableRuntimeMarshalling] stays off for now. Every P/Invoke
         in this assembly is [LibraryImport], but the ten native reverse-entry thunks are
         registered with Marshal.GetFunctionPointerForDelegate, which runtime marshalling
         disabled refuses. Converting them to [UnmanagedCallersOnly] + delegate* unmanaged is
         blocked by the interaction harness, which invokes all ten thunks directly from managed
         code (audit3 host-callback probe); managed invocation of an UnmanagedCallersOnly method
         is invalid. The switch becomes available once the callbacks no longer need managed
         invocation. -->
  </PropertyGroup>
</Project>
